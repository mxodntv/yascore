[Unit]
Description=Yascore — Yasmina assistant (Qwen + Silero + YouTube Music)
After=network-online.target

[Service]
# Repo template. Installed user units under ~/.config/systemd/user are local.
WorkingDirectory=/opt/yascore
ExecStart=/opt/yascore/bin/yascore
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
